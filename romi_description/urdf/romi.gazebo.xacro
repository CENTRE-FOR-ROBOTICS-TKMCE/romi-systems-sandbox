<?xml version="1.0"?>
<robot name="romi_sim" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Wheel velocity controllers:
       wheel_pid_controller converts /cmd_vel into left/right wheel commands,
       which are then sent to Gazebo. -->

  <gazebo>
    <plugin filename="ignition-gazebo-joint-controller-system"
            name="gz::sim::systems::JointController">
      <joint_name>wheel_left_joint</joint_name>
      <topic>/left_motor_command</topic>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin filename="ignition-gazebo-joint-controller-system"
            name="gz::sim::systems::JointController">
      <joint_name>wheel_right_joint</joint_name>
      <topic>/right_motor_command</topic>
    </plugin>
  </gazebo>


  <!-- Publishes odometry independently of wheel velocity control. -->

  <gazebo>
    <plugin filename="libignition-gazebo-odometry-publisher-system.so"
            name="ignition::gazebo::systems::OdometryPublisher">
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <dimensions>3</dimensions>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
  </gazebo>


  <!-- Publishes /joint_states so robot_state_publisher
       can publish the robot's joint transforms. -->

  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
      <joint_name>wheel_left_joint</joint_name>
      <joint_name>wheel_right_joint</joint_name>
    </plugin>
  </gazebo>


  <!-- 2D LiDAR sensor, published on /scan. -->

  <gazebo reference="base_scan_link">
    <sensor name="lidar" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <topic>scan</topic>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>

      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>0.0</min_angle>
            <max_angle>6.28319</max_angle>
          </horizontal>
        </scan>

        <range>
          <min>0.120</min>
          <max>3.5</max>
          <resolution>0.015</resolution>
        </range>

        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

</robot>