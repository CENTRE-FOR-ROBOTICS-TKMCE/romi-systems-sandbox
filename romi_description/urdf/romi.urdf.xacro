<?xml version="1.0" ?>
<robot name="romi" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:include filename="$(find romi_description)/urdf/common_properties.xacro"/>
  <xacro:include filename="$(find romi_description)/urdf/lidar.xacro"/>

  <!-- ===================== physical parameters ===================== -->
  <xacro:property name="base_link_mass" value="8.2573504e-01"/>
  <xacro:property name="base_link_collision_l" value="0.1635"/>
  <xacro:property name="base_link_collision_w" value="0.145"/>
  <xacro:property name="base_link_collision_h" value="0.05"/>

  <xacro:property name="wheel_mass" value="2.8498940e-02"/>
  <xacro:property name="wheel_width" value="0.018"/>
  <xacro:property name="wheel_radius" value="0.0345"/>
  <xacro:property name="wheel_separation" value="0.140"/>

  <xacro:property name="caster_mass" value="0.0005"/>
  <xacro:property name="caster_collision_l" value="0.01"/>
  <xacro:property name="caster_collision_w" value="0.01"/>
  <xacro:property name="caster_collision_h" value="0.01"/>

  <!-- included after the properties above so the Gazebo plugin block can use them -->
  <xacro:include filename="$(find romi_description)/urdf/romi.gazebo.xacro"/>

  <!-- ===================== base ===================== -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 3.14159"/>
      <geometry>
        <mesh filename="package://romi_description/meshes/bases/romi_base.stl" scale="1 1 1"/>
      </geometry>
      <material name="light_black"/>
    </visual>

    <collision>
      <origin xyz="0.0 0.0 0.0315" rpy="0 0 0"/>
      <geometry>
        <box size="${base_link_collision_l} ${base_link_collision_w} ${base_link_collision_h}"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.0315" rpy="0 0 0"/>
      <mass value="${base_link_mass}"/>
      <inertia
        ixx="${(1/12) * base_link_mass * (base_link_collision_w**2 + base_link_collision_h**2)}" ixy="0" ixz="0"
        iyy="${(1/12) * base_link_mass * (base_link_collision_l**2 + base_link_collision_h**2)}" iyz="0"
        izz="${(1/12) * base_link_mass * (base_link_collision_l**2 + base_link_collision_w**2)}"/>
    </inertial>
  </link>

  <!-- ===================== drive wheels ===================== -->
  <joint name="wheel_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_left_link"/>
    <origin xyz="0.0 ${wheel_separation/2} ${wheel_radius}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="wheel_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="3.14159 0 0"/>
      <geometry>
        <mesh filename="package://romi_description/meshes/wheels/romi-left-wheel.stl" scale="1 1 1"/>
      </geometry>
      <material name="dark"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="${wheel_width}" radius="${wheel_radius}"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <mass value="${wheel_mass}"/>
      <inertia
        ixx="${(1/12) * wheel_mass * (3 * wheel_radius**2 + wheel_width**2)}" ixy="0" ixz="0"
        iyy="${(1/12) * wheel_mass * (3 * wheel_radius**2 + wheel_width**2)}" iyz="0"
        izz="${(1/2) * wheel_mass * wheel_radius**2}"/>
    </inertial>
  </link>

  <joint name="wheel_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_right_link"/>
    <origin xyz="0.0 ${-wheel_separation/2} ${wheel_radius}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="wheel_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://romi_description/meshes/wheels/romi-right-wheel.stl" scale="1 1 1"/>
      </geometry>
      <material name="dark"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="${wheel_width}" radius="${wheel_radius}"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <mass value="${wheel_mass}"/>
      <inertia
        ixx="${(1/12) * wheel_mass * (3 * wheel_radius**2 + wheel_width**2)}" ixy="0" ixz="0"
        iyy="${(1/12) * wheel_mass * (3 * wheel_radius**2 + wheel_width**2)}" iyz="0"
        izz="${(1/2) * wheel_mass * wheel_radius**2}"/>
    </inertial>
  </link>

  <!-- ===================== rear caster ===================== -->
  <joint name="caster_back_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_back_link"/>
    <origin xyz="-0.0441 0.0435 0.0" rpy="0 0 0"/>
  </joint>

  <link name="caster_back_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://romi_description/meshes/wheels/romi-back-castor.stl" scale="1 1 1"/>
      </geometry>
      <material name="dark"/>
    </visual>

    <collision>
      <origin xyz="0.0 -0.045 0.005" rpy="0 0 0"/>
      <geometry>
        <box size="${caster_collision_l} ${caster_collision_w} ${caster_collision_h}"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${caster_mass}"/>
      <inertia
        ixx="${(1/12) * caster_mass * (caster_collision_w**2 + caster_collision_h**2)}" ixy="0" ixz="0"
        iyy="${(1/12) * caster_mass * (caster_collision_l**2 + caster_collision_h**2)}" iyz="0"
        izz="${(1/12) * caster_mass * (caster_collision_l**2 + caster_collision_w**2)}"/>
    </inertial>
  </link>

  <!-- ===================== 2D LiDAR ===================== -->
  <xacro:lidar_device name="base_scan" parent="base_link">
    <origin xyz="0.0 0.0 0.181" rpy="0 0 0"/>
  </xacro:lidar_device>

</robot>
